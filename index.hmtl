/* =========================================================
   IDIOMA ACTUAL
========================================================= */

function getCurrentLocale() {

    const selected =
        document
        .getElementById("language")
        .value;

    if(selected === "auto") {

        return (
            navigator.language ||
            "en"
        );
    }

    return selected;
}

function translatePage() {

    let language =
        document
        .getElementById("language")
        .value;

    if(language === "auto") {

        language =
            (
                navigator.language ||
                "en"
            )
            .split("-")[0];
    }

    const t =
        translations[language]
        ||
        translations.en;

    document
        .getElementById("exploreButton")
        .textContent =
        t.explore;

    document
        .getElementById("timerButton")
        .textContent =
        t.timer;

    document
        .getElementById("galleryButton")
        .textContent =
        t.gallery;

    document
        .getElementById("galleryTitle")
        .textContent =
        t.gallery;

    document
        .getElementById("timerSubtitle")
        .textContent =
        t.subtitle;

    document
        .getElementById("yearsLabel")
        .textContent =
        t.years;

    document
        .getElementById("daysLabel")
        .textContent =
        t.days;

    document
        .getElementById("hoursLabel")
        .textContent =
        t.hours;

    document
        .getElementById("minutesLabel")
        .textContent =
        t.minutes;

    document
        .getElementById("secondsLabel")
        .textContent =
        t.seconds;

    if(language === "ar") {

        document.documentElement.dir =
            "rtl";

    }

    else {

        document.documentElement.dir =
            "ltr";

    }

    updateTimer();
}

document
    .getElementById("language")
    .addEventListener(
        "change",
        translatePage
    );

/* =========================================================
   INICIAR
========================================================= */

translatePage();

updateTimer();

setInterval(
    updateTimer,
    1000
);

setStage(0);

updateExplore();

</script>

